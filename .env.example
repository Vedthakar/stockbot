# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Use PAPER keys. Get them free at https://app.alpaca.markets
# (switch the account picker to "Paper" -> API Keys -> Generate).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: refuse to start unless the keys belong to this account number
# (shown on your Alpaca dashboard). A guard against pasting the wrong keys.
ALPACA_EXPECTED_ACCOUNT_ID=

# Optional endpoint overrides. Leave blank for Alpaca's defaults:
#   paper  https://paper-api.alpaca.markets
#   live   https://api.alpaca.markets      (only used with `main.py --live`)
#   data   https://data.alpaca.markets
ALPACA_PAPER_URL=
ALPACA_LIVE_URL=
ALPACA_DATA_URL=

# Optional: market data feed. "iex" is free; "sip" needs a data subscription.
ALPACA_DATA_FEED=

# Optional: only if you point the judge at Groq instead of local LM Studio
# (see the judge: section of config.yaml).
GROQ_API_KEY=
